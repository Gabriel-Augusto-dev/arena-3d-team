rules_version = '2';

// Regras de segurança da 3D Team
// Publique em: Console do Firebase → Firestore Database → Regras (copie e cole este arquivo)
// ou pelo terminal: npx firebase-tools deploy --only firestore --project SEU_PROJETO
//
// Perfis (campo `perfil` do documento usuarios/{uid}):
//   professor → administrador: pode tudo, é o único que confirma pagamentos
//   auxiliar  → professor auxiliar: LÊ alunos, aulas, presenças e pagamentos; cria e
//               edita só as PRÓPRIAS turmas (e as aulas delas); não mexe em dinheiro
//   aluno     → só os próprios dados
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function usuarioAtual() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // O perfil vem do documento usuarios/{uid}: ninguém escolhe ser professor.
    // Conta desativada (ativo = false) perde o acesso na hora.
    function ehProfessor() {
      return logado() && usuarioAtual().perfil == 'professor' && usuarioAtual().ativo == true;
    }

    // Professor ou professor auxiliar (leitura da área da equipe)
    function ehEquipe() {
      return logado() && usuarioAtual().perfil in ['professor', 'auxiliar'] && usuarioAtual().ativo == true;
    }

    // Professor auxiliar com a conta ativa
    function ehAuxiliar() {
      return logado() && usuarioAtual().perfil == 'auxiliar' && usuarioAtual().ativo == true;
    }

    // A turma é do auxiliar logado?
    function turmaDoAuxiliar(turmaId) {
      return get(/databases/$(database)/documents/turmas/$(turmaId)).data.get('responsavelId', null) == request.auth.uid;
    }

    // Aluno com a conta ativa (as gravações do aluno passam por aqui)
    function ehAluno() {
      return logado() && usuarioAtual().perfil == 'aluno' && usuarioAtual().ativo == true;
    }

    function caminho(colecao, id) {
      return /databases/$(database)/documents/$(colecao)/$(id);
    }

    // Mensalista associado? (campo pode não existir em cadastros antigos)
    function ehAssociado() {
      return usuarioAtual().get('associado', false) == true;
    }

    function configuracoes() {
      return get(caminho('configuracoes', 'geral')).data;
    }

    // Mensalidade: a de associado, quando ele é associado e o valor está definido (> 0)
    function valorCerto(valor, normal, deAssociado) {
      return (ehAssociado() && deAssociado > 0 && valor == deAssociado)
        || (!(ehAssociado() && deAssociado > 0) && valor == normal);
    }

    function ehDono(uid) {
      return logado() && request.auth.uid == uid;
    }

    function soAltera(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // ---------------- Usuários ----------------
    match /usuarios/{uid} {
      allow read: if ehDono(uid) || ehEquipe();

      // Cadastro feito pelo próprio aluno: escolhe Day Use (avulso) ou mensalista com turma.
      // A mensalidade começa sem validade: só libera quando o professor confirmar o pagamento.
      // Contas de auxiliar e alunos cadastrados pelo professor são criadas pelo servidor (Admin SDK).
      allow create: if ehProfessor() || (
        ehDono(uid)
        && request.resource.data.perfil == 'aluno'
        && request.resource.data.ativo == true
        && (
          (request.resource.data.plano == 'avulso' && request.resource.data.turmaId == null)
          || (request.resource.data.plano == 'mensalista' && request.resource.data.turmaId is string)
        )
        && request.resource.data.validadeMensalidade == null
        // mensalista de várias turmas: no cadastro, só a turma escolhida e sem validade
        && (request.resource.data.get('turmasIds', []).size() == 0
          || (request.resource.data.turmaId is string
            && request.resource.data.get('turmasIds', []) == [request.resource.data.turmaId]))
        && request.resource.data.get('validades', {}).size() == 0
        && request.resource.data.get('associado', false) == false
        // o e-mail começa NÃO confirmado: só o servidor marca depois do link do e-mail
        && request.resource.data.get('emailConfirmado', false) == false
        // a turma escolhida precisa existir e estar ativa
        && (request.resource.data.turmaId == null || get(caminho('turmas', request.resource.data.turmaId)).data.ativa == true)
      );

      allow update: if ehProfessor()
        // qualquer pessoa edita os próprios dados básicos
        || (ehDono(uid) && soAltera(['nome', 'whatsapp', 'dataNascimento', 'percentualProprio', 'atualizadoEm']));

      allow delete: if ehProfessor();
    }

    // ---------------- Turmas, aulas e configurações ----------------
    // Turmas e configurações são lidas também na tela de cadastro (antes do login)
    // O auxiliar cria e edita só as turmas em que ele é o responsável.
    // O preço da mensalidade é do administrador: o auxiliar cria com o valor padrão e não altera
    match /turmas/{id} {
      allow read: if true;
      allow create: if ehProfessor()
        || (ehAuxiliar()
          && request.resource.data.responsavelId == request.auth.uid
          && request.resource.data.valorMensalidade == configuracoes().valorMensalidadePadrao);
      allow update: if ehProfessor()
        || (ehAuxiliar()
          && resource.data.get('responsavelId', null) == request.auth.uid
          && request.resource.data.responsavelId == request.auth.uid
          && request.resource.data.valorMensalidade == resource.data.valorMensalidade);
      allow delete: if ehProfessor()
        || (ehAuxiliar() && resource.data.get('responsavelId', null) == request.auth.uid);
    }

    // Aulas: o auxiliar só gera e ajusta as aulas das turmas dele (cancelar aula é do administrador)
    match /aulas/{id} {
      allow read: if logado();
      allow create: if ehProfessor()
        || (ehAuxiliar()
          && request.resource.data.responsavelId == request.auth.uid
          && turmaDoAuxiliar(request.resource.data.turmaId)
          && request.resource.data.status == 'agendada');
      allow update: if ehProfessor()
        || (ehAuxiliar()
          && turmaDoAuxiliar(resource.data.turmaId)
          && request.resource.data.turmaId == resource.data.turmaId
          && request.resource.data.responsavelId == request.auth.uid
          && request.resource.data.status == resource.data.status);
      allow delete: if ehProfessor()
        || (ehAuxiliar() && turmaDoAuxiliar(resource.data.turmaId));
    }

    match /configuracoes/{id} {
      allow read: if true;
      allow write: if ehProfessor();
    }

    // ---------------- Presenças ----------------
    match /presencas/{id} {
      // Aluno vê as próprias presenças; professor e auxiliar veem todas
      allow read: if ehEquipe()
        || (logado() && (resource == null || resource.data.alunoId == request.auth.uid));

      // Aluno marca presença em nome dele. O tipo (mensalista / day_use)
      // é decidido no app; o bloqueio por Day Use em atraso também é conferido no app.
      allow create: if ehProfessor() || (
        ehAluno()
        && request.resource.data.alunoId == request.auth.uid
        && request.resource.data.status == 'confirmada'
        && (
          // mensalista: sem custo
          (request.resource.data.tipo == 'mensalista' && usuarioAtual().plano == 'mensalista'
            && request.resource.data.pagamentoId == null)
          // Day Use: a cobrança "a pagar" é gravada junto, no mesmo lote
          || (request.resource.data.tipo == 'day_use'
            && request.resource.data.pagamentoId is string
            && getAfter(caminho('pagamentos', request.resource.data.pagamentoId)).data.alunoId == request.auth.uid
            && getAfter(caminho('pagamentos', request.resource.data.pagamentoId)).data.status == 'pendente'
            && getAfter(caminho('pagamentos', request.resource.data.pagamentoId)).data.presencaId == id)
        )
      );

      // Aluno só pode desmarcar a própria presença
      allow update: if ehProfessor() || (
        ehAluno()
        && resource.data.alunoId == request.auth.uid
        && request.resource.data.status == 'cancelada'
        && soAltera(['status', 'atualizadoEm'])
      );

      allow delete: if ehProfessor();
    }

    // ---------------- Pagamentos ----------------
    match /pagamentos/{id} {
      // Professor e auxiliar veem se cada aluno pagou; o aluno vê os dele
      allow read: if ehEquipe()
        || (logado() && (resource == null || resource.data.alunoId == request.auth.uid));

      // Aluno cria cobrança de Day Use (pendente) ou avisa mensalidade paga (em_analise).
      // Confirmar é exclusivo do professor administrador.
      allow create: if ehProfessor() || (
        ehAluno()
        && request.resource.data.alunoId == request.auth.uid
        && request.resource.data.confirmadoPor == null
        && request.resource.data.confirmadoEm == null
        && (
          // Day Use: valor definido nos Ajustes, ligado à presença gravada no mesmo lote
          (request.resource.data.tipo == 'day_use'
            && request.resource.data.status == 'pendente'
            && request.resource.data.valor == configuracoes().valorDayUse
            && request.resource.data.presencaId is string
            && getAfter(caminho('presencas', request.resource.data.presencaId)).data.alunoId == request.auth.uid
            && getAfter(caminho('presencas', request.resource.data.presencaId)).data.pagamentoId == id)
          // Mensalidade avisada pelo aluno (normalmente gravada pelo servidor; esta regra
          // vale quando o servidor está sem as credenciais do Firebase Admin)
          || (request.resource.data.tipo == 'mensalidade'
            && request.resource.data.status == 'em_analise'
            && request.resource.data.turmaId is string
            && (request.resource.data.turmaId == usuarioAtual().get('turmaId', null)
              || request.resource.data.turmaId in usuarioAtual().get('turmasIds', []))
            && valorCerto(
              request.resource.data.valor,
              get(caminho('turmas', request.resource.data.turmaId)).data.valorMensalidade,
              configuracoes().get('valorMensalidadeAssociado', 0)
            ))
        )
      );

      // Aluno: avisar que pagou (pendente → em_analise) ou cancelar ao desmarcar presença
      allow update: if ehProfessor() || (
        ehAluno()
        && resource.data.alunoId == request.auth.uid
        && resource.data.status == 'pendente'
        && (
          (request.resource.data.status == 'em_analise'
            && soAltera(['status', 'informadoEm', 'observacaoAluno', 'motivoRecusa', 'atualizadoEm']))
          // só junto com a presença desmarcada (mesmo lote)
          || (request.resource.data.status == 'cancelado'
            && soAltera(['status', 'motivoRecusa', 'atualizadoEm'])
            && getAfter(caminho('presencas', resource.data.presencaId)).data.status == 'cancelada')
        )
      );

      allow delete: if false;
    }

    // ---------------- Notificações ----------------
    match /notificacoes/{id} {
      function destinatario() {
        return (logado() && resource.data.usuarioId == request.auth.uid)
          || (ehProfessor() && resource.data.paraPerfil == 'professor');
      }

      allow read: if destinatario();

      // Aluno só cria avisos para o professor (PIX avisado, cadastro novo),
      // sempre com link interno do app; o professor avisa qualquer um
      allow create: if ehProfessor() || (
        ehAluno()
        && request.resource.data.paraPerfil == 'professor'
        && request.resource.data.usuarioId == null
        && request.resource.data.lida == false
        && (request.resource.data.link == null || request.resource.data.link.matches('^/(professor|aluno)(/[A-Za-z0-9_/-]*)?$'))
      );

      allow update: if destinatario() && soAltera(['lida', 'atualizadoEm']);
      allow delete: if ehProfessor();
    }
  }
}
