# ===================================================================
# Variáveis de ambiente da 3D Team
# No computador: copie este arquivo para ".env.local" e preencha.
# No Vercel: Settings → Environment Variables (mesmos nomes).
# ===================================================================

# --- Firebase (navegador) ------------------------------------------
# Console do Firebase → ⚙ Configurações do projeto → Geral → Seus apps → App da Web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (servidor — NUNCA comece com NEXT_PUBLIC_) -----
# Console do Firebase → ⚙ Configurações do projeto → Contas de serviço → Gerar nova chave privada
# Cole o conteúdo INTEIRO do arquivo .json baixado (no Vercel pode colar com as quebras de linha).
FIREBASE_ADMIN_CREDENCIAIS=
# Alternativa às credenciais em JSON (use uma OU outra):
# FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- E-mails pelo Brevo (SMTP) -------------------------------------
# Brevo → Configurações → SMTP e API → aba SMTP
BREVO_SMTP_USUARIO=
BREVO_SMTP_CHAVE=
# Remetente validado no Brevo (Remetentes, domínios e IPs)
EMAIL_REMETENTE=
# Nome que aparece no e-mail (vazio = nome da arena salvo em Ajustes)
EMAIL_REMETENTE_NOME=
# Opcionais (padrão do Brevo)
# BREVO_SMTP_HOST=smtp-relay.brevo.com
# BREVO_SMTP_PORTA=587

# --- Endereço público do app (links dos e-mails) -------------------
# Ex.: https://app.3dteam.com.br  (vazio = usa o domínio de onde veio o pedido)
URL_APP=

# --- Só para desenvolvimento com os emuladores do Firebase ---------
# NEXT_PUBLIC_FIREBASE_EMULADOR=true
